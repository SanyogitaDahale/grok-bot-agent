# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# NextAuth / Auth.js Credentials
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-key-at-least-32-chars-long

# OAuth Providers (Optional: configure if using OAuth)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Composio tool connections
COMPOSIO_API_KEY=ak_H6w1tLZaS3xUGRS7LKHu

# E2B Desktop sandboxes (get a key from https://e2b.dev/dashboard)
E2B_API_KEY=your_e2b_api_key

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
OPENAI_MODEL=gpt-5.4-mini
# Used only when the agent needs to operate the E2B VM desktop.
OPENAI_COMPUTER_MODEL=gpt-5.6-luna
# Required to send Inngest events in production; local development uses Inngest Dev Server.
INNGEST_EVENT_KEY=
